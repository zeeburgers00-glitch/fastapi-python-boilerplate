APP_NAME=YouTube AI Factory API
APP_ENV=development
DATABASE_PATH=./data/youtube_factory.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Multi-provider LLM fallback. Add keys for providers you choose to use.
# Auto order: Groq -> Gemini -> OpenRouter -> local Ollama.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

YOUTUBE_DATA_API_KEY=
FFMPEG_BINARY=ffmpeg
PEXELS_API_KEY=
PIPER_BINARY=piper
PIPER_MODEL_PATH=
MAX_UPLOAD_MB=500
